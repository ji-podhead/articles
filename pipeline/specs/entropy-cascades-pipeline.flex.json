              "avg over response · thr 0.45",
              "phase-1 error → fail-open:",
              "normal routing continues"
            ]
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "gap": 24,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "p1",
            "title": "Phase 1: Routing Model",
            "lines": [
              "cheap · full response · stream=false"
            ],
            "color": "green"
          },
          {
            "type": "card",
            "id": "reason",
            "title": "Reasoning Model",
            "lines": [
              "expensive · chain routing"
            ],
            "color": "amber"
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "gap": 24,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "accept",
            "title": "✓ Serve directly",
            "lines": [
              "fast · cheap-model price"
            ],
            "color": "green"
          },
          {
            "type": "card",
            "id": "esc",
            "title": "✗ Discard answer · re-route original request",
            "lines": [
