    "children": [
      {
        "type": "row",
        "style": {
          "gap": 20,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "client",
            "title": "Client",
            "lines": [
              "request"
            ]
          },
          {
            "type": "card",
            "id": "gate",
            "title": "Entropy Gate",
            "lines": [
              "logprobs · top_logprobs=5",
