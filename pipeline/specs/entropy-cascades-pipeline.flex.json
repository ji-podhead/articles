{
  "width": 1200,
  "padding": 40,
  "tree": {
    "type": "column",
    "style": {
      "gap": 24
    },
    "children": [
      {
        "type": "row",
        "style": {
          "gap": 20,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "client",
            "title": "Client",
            "lines": [
              "request"
            ],
            "style": {
              "padding": 16
            }
          },
          {
            "type": "card",
            "id": "gate",
            "title": "Entropy Gate",
            "lines": [
              "logprobs \u00b7 top_logprobs=5",
              "H_norm = H / log\u2082(k)",
              "avg over response \u00b7 thr 0.45",
              "phase-1 error \u2192 fail-open:",
              "normal routing continues"
            ],
            "style": {
              "padding": 16
            }
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "gap": 24,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "p1",
            "title": "Phase 1: Routing Model",
            "lines": [
              "cheap \u00b7 full response \u00b7 stream=false"
            ],
            "color": "green",
            "style": {
              "padding": 16
            }
          },
          {
            "type": "card",
            "id": "reason",
            "title": "Reasoning Model",
            "lines": [
              "expensive \u00b7 chain routing"
            ],
            "color": "amber",
            "style": {
              "padding": 16
            }
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "gap": 24,
          "justify": "center"
        },
        "children": [
          {
            "type": "card",
            "id": "accept",
            "title": "\u2713 Serve directly",
            "lines": [
              "fast \u00b7 cheap-model price"
            ],
            "color": "green",
            "style": {
              "padding": 16
            }
          },
          {
            "type": "card",
            "id": "esc",
            "title": "\u2717 Discard answer \u00b7 re-route original request",
            "lines": [
              "normal chain: bandit \u00b7 failover \u00b7 quota \u00b7 feedback"
            ],
            "color": "amber",
            "style": {
              "padding": 16
            }
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "gap": 12,
          "justify": "center"
        },
        "children": [
          {
            "type": "chip",
            "text": "jimesh gateway \u00b7 entropy-gated cascade \u00b7 no classifier, no labeled data"
          }
        ]
      }
    ]
  },
  "connect": [
    {
      "from": "client",
      "to": "gate"
    },
    {
      "from": "gate",
      "to": "p1",
      "label": "probe",
      "color": "green"
    },
    {
      "from": "gate",
      "to": "reason",
      "label": "escalate",
      "color": "amber"
    },
    {
      "from": "p1",
      "to": "accept",
      "label": "H < 0.45",
      "color": "green"
    },
    {
      "from": "reason",
      "to": "esc",
      "label": "H \u2265 0.45",
      "color": "amber"
    }
  ]
}
